# Những thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret
.env
.env.*

# Git & CI
.git
.gitignore
.github

# Python / môi trường local
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Không cần khi chạy app
tests
screenshots
*.md
grade.py
Dockerfile
.dockerignore
docker-compose.yml
railway.toml
render.yaml
nginx
